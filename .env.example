# ==============================================================================
# StudySpace Environment Variables
# Copy this file to .env.local and configure with your credentials.
# ==============================================================================

# Supabase Configuration (Client & Server)
# Required: URL and anonymous public key from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# YouTube Data API v3 (Server-Only Secret - Never expose to browser)
# Required: API key with YouTube Data API v3 enabled from Google Cloud Console
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Site URL (Optional)
# Base URL for OpenGraph metadata and sitemap generation (defaults to https://studyspace.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
