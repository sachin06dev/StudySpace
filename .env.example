# ==============================================================================
# StudySpace — Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (Required for Web & Mobile)
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Optional: Supabase service_role key for admin account deletion fallback
# NEVER prefix with NEXT_PUBLIC_. Only read on trusted server environments.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Google Cloud / YouTube Data API v3 (Required for Lecture Hub)
# Found in: Google Cloud Console -> APIs & Services -> Credentials
# Server-only: used strictly in Next.js Server Components / API proxy routes.
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your-google-cloud-youtube-api-key

# ------------------------------------------------------------------------------
# 3. Multimodal AI Timetable OCR Scanner (Optional)
# Enables automated timetable extraction from timetable photos & screenshots.
# Primary: Google Gemini 2.0 / 1.5 Flash. Fallback: OpenAI GPT-4o.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Object Storage (Dual-Storage Architecture for Documents & APK)
# Found in: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# S3-compatible object storage with zero egress fees.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=studyspace-documents

# ------------------------------------------------------------------------------
# 5. Site & Canonical Domain Configuration (Optional)
# Base URL for OpenGraph metadata, sitemap generation, and OAuth redirects.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
