  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Request & Mutation Path",
      "items": [
        "Web interactions trigger React Server Components (RSC) and Next.js Server Actions ('use server')",
        "Edge Middleware updates Supabase session cookies and enforces auth guards on all matched routes",
        "Server Actions query the Data Access Layer (lib/data/*) which talks directly to PostgreSQL with RLS (auth.uid() = user_id)",
        "Mutations return structured result types and trigger revalidatePath() to refresh cached layouts"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Secret Isolation",
      "items": [
        "Next.js Server Boundary strictly encapsulates upstream API secrets (YOUTUBE_API_KEY, GEMINI_API_KEY, R2_SECRET_ACCESS_KEY)",
        "Browser and mobile apps never receive server credentials; third-party calls are brokered via API Route Handlers",
        "PostgreSQL enforces database-level tenant isolation via Row Level Security (RLS) policies",
        "Private study PDFs are secured using short-lived S3/R2 presigned upload and download URLs"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cross-Platform & Offline Strategy",
      "items": [
        "Flutter mobile client operates offline-first using local SQLite persistence and an idempotent background sync queue",
        "Mobile client calls Next.js API routes using Bearer token authentication verified via Supabase JWT",
        "Attendance algorithms, bunk limits, and consistency scoring formulas are mathematically identical across Web and Mobile"
      ]
    }
  ]
