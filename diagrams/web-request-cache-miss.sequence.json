  "cards": [
    {
      "dot": "emerald",
      "title": "Cache-Aside Pattern (Lazy Loading)",
      "items": [
        "The API handles caching explicitly, querying Redis before touching the database",
        "Data is only loaded into the cache on demand upon the first read request",
        "Subsequent requests for the same key achieve sub-millisecond response times"
      ]
    },
    {
      "dot": "rose",
      "title": "Cache Miss Handling",
      "items": [
        "Redis returns nil/null when the key is absent or expired, without throwing an error",
        "The API gracefully intercepts the miss and falls back to PostgreSQL",
        "Authoritative rows are fetched directly from primary persistent storage"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache Population & Freshness",
      "items": [
        "The API serializes PostgreSQL results and writes to Redis using SETEX with a TTL",
        "TTL ensures stale keys expire automatically even without active invalidation",
        "Future reads are served directly from cache memory, shielding PostgreSQL from load"
      ]
    }
  ]
}
